<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ace_canvas">#FAF7F2</color>
    <color name="ace_navy">#181847</color>
    <color name="ace_orange">#F44E1C</color>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ace_navy</item>
        <item name="android:navigationBarColor">@color/ace_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ace_navy</item>
        <item name="android:navigationBarColor">@color/ace_canvas</item>
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>